 extension ViewController: WKUIDelegate, WKDownloadDelegate {
+    // iOS 27 requires the WKWebView host app to explicitly request a geolocation
+    // permission prompt. Only prompt for the app's trusted main-frame origin.
+    @available(iOS 27.0, *)
+    func webView(
+        _ webView: WKWebView,
+        requestGeolocationPermissionFor origin: WKSecurityOrigin,
+        initiatedByFrame frame: WKFrameInfo,
+        decisionHandler: @escaping @MainActor @Sendable (WKPermissionDecision) -> Void
+    ) {
+        guard frame.isMainFrame, allowedOrigins.contains(origin.host) else {
+            decisionHandler(.deny)
+            return
+        }
+
+        decisionHandler(.prompt)
+    }
+
